# ============================================================
# Responsive Agent — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=responsive-agent-app-secret-key-2026-secure
LOG_LEVEL=INFO

# --- Tenancy ---
# TENANCY_MODE: "single" or "multi"
TENANCY_MODE=single
DEFAULT_TENANT_ID=default

# --- Database (PostgreSQL with pgvector) ---
# Matches docker-compose.yml postgres service
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/responsive_agent
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/responsive_agent

# --- Redis (Celery Broker & Result Backend) ---
# Matches docker-compose.yml redis service
REDIS_URL=redis://localhost:6379/0

# --- Vector Store (Qdrant) ---
# Matches docker-compose.yml qdrant service
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=responsive_agent_docs

# --- Embeddings ---
# EMBEDDING_PROVIDER: "google", "openai", "cohere", "local"
EMBEDDING_PROVIDER=google
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
COHERE_API_KEY=your-cohere-api-key

# Google Embedding Model & Dimension
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# OpenAI Embedding Model & Dimension
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSION=3072

# Cohere Embedding Model & Dimension
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_EMBEDDING_DIMENSION=1024

# Local Embedding Model (BGE-M3 via sentence-transformers)
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DIMENSION=1024

# --- Deterministic Reranking ---
# RERANKER_PROVIDER: "cohere", "google", "local"
RERANKER_PROVIDER=cohere
RERANKER_MODEL=rerank-english-v3.0
GOOGLE_RERANKER_MODEL=semantic-ranker-512@latest
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=8
RERANKER_MIN_SCORE=0.0001

# --- RAG Retrieval Tuning ---
RAG_TOP_K_RETRIEVE=40
RAG_TOP_K_FINAL=8
RAG_DENSE_WEIGHT=0.7
RAG_BM25_WEIGHT=0.3

# --- LLM Models ---
ORCHESTRATOR_MODEL=gemini-3.5-flash-lite
FAST_MODEL=gemini-3.5-flash-lite
SUMMARIZER_MODEL=gemini-3.5-flash-lite

# --- Web Refresh Scheduler ---
# Default refresh frequency for web sources
# REFRESH_DEFAULT_UNIT: minute | hour | day | week
REFRESH_DEFAULT_VALUE=24
REFRESH_DEFAULT_UNIT=hour

# --- Model Context Protocol (MCP) Registry ---
# Must be at least 32 characters for AES encryption key derivation
MCP_CREDENTIAL_ENCRYPTION_KEY=responsive-agent-mcp-aes256-key-32b!
MCP_DEFAULT_READ_ONLY=true
MCP_MAX_SERVERS_PER_QUERY=3

# --- Authentication & JWT ---
JWT_SECRET=responsive-agent-jwt-secret-key-prod-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-api-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- UI / Chat Display Flags ---
SHOW_EVIDENCE_SOURCES=false

# --- Weather API Key (for MCP Weather Agent) ---
WEATHERAPI_KEY=your-weather-api-key